.add-page {
  padding: 24rpx 32rpx 240rpx;
  background:
    radial-gradient(ellipse 130% 40% at 50% 0%, rgba(0, 212, 255, 0.07) 0%, transparent 70%),
    var(--bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 油耗预览卡 ============ */

.preview-card {
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  transition: all 0.3s;
}

.preview-card.has-value {
  background: linear-gradient(160deg, rgba(0, 212, 255, 0.13) 0%, var(--bg-card) 65%);
  border-color: rgba(0, 212, 255, 0.3);
}

.pv-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pv-label {
  font-size: 23rpx;
  color: var(--t3);
  letter-spacing: 1rpx;
}

.pv-badge {
  font-size: 19rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--cyan-soft);
  color: var(--cyan);
  font-weight: 600;
}

.pv-badge.muted {
  background: rgba(255, 255, 255, 0.05);
  color: var(--t4);
}

.pv-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.pv-value.placeholder {
  opacity: 0.65;
}

.pv-num {
  color: var(--cyan);
  text-shadow: 0 0 32rpx rgba(0, 212, 255, 0.5);
}

.pv-dash {
  font-family: "SF Mono", Consolas, monospace;
  font-size: 64rpx;
  color: var(--t4);
  line-height: 1;
}

.pv-hint {
  font-size: 22rpx;
  color: var(--t3);
  line-height: 1.6;
}

/* ============ 输入卡 ============ */

.input-card {
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.big-field {
  padding: 34rpx 0;
}

.big-input {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.input-side {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex: 1;
  justify-content: flex-end;
}

.input-unit {
  font-size: 24rpx;
  color: var(--t3);
  flex-shrink: 0;
  min-width: 56rpx;
  text-align: right;
}

.label-side {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.label-sub {
  font-size: 20rpx;
  color: var(--t4);
}

.field-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  margin: 0 0 20rpx;
  border-radius: var(--r-sm);
  background: var(--cyan-soft);
}

.field-tip:active {
  opacity: 0.7;
}

.ft-icon {
  font-size: 24rpx;
  color: var(--cyan);
}

.ft-text {
  font-size: 22rpx;
  color: var(--cyan);
}

/* ============ 加满开关卡 ============ */

.full-card {
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
}

.lb-side {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  padding-right: 20rpx;
}

.lb-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}

.lb-sub {
  font-size: 21rpx;
  color: var(--t3);
  line-height: 1.5;
}

.warn-tip {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: var(--r-sm);
  background: var(--amber-soft);
  border-left: 4rpx solid var(--amber);
}

.wt-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--amber);
  color: #1A1200;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wt-text {
  flex: 1;
  font-size: 22rpx;
  color: #FFC44D;
  line-height: 1.6;
}

/* ============ Picker ============ */

.picker-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  color: var(--t1);
  font-family: "SF Mono", Consolas, monospace;
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--t4);
}

/* ============ 保养模板网格 ============ */

.tpl-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tpl-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: var(--r-md);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  transition: all 0.18s;
}

.tpl-item.active {
  background: var(--cyan-soft);
  border-color: rgba(0, 212, 255, 0.36);
}

.tpl-item:active {
  transform: scale(0.985);
}

.tpl-icon {
  font-size: 36rpx;
  width: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.tpl-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.tpl-name {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--t1);
}

.tpl-cycle {
  font-size: 20rpx;
  color: var(--t3);
  font-family: "SF Mono", Consolas, monospace;
}

.tpl-check {
  font-size: 30rpx;
  color: var(--cyan);
  font-weight: 700;
}

/* ============ 保养提示 ============ */

.maint-hint {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: var(--r-md);
  background: rgba(191, 90, 242, 0.07);
  border: 1rpx solid rgba(191, 90, 242, 0.16);
}

.mh-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.mh-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--t2);
  line-height: 1.68;
}

/* ============ 底部操作栏 ============ */

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(11, 15, 23, 0.94);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--line);
  z-index: 40;
}

.del-btn {
  width: 180rpx;
  flex-shrink: 0;
}

.btn-disabled {
  opacity: 0.6;
}
