.garage-page {
  padding: 24rpx 32rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 车辆卡片 ============ */

.car-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.car-card {
  position: relative;
  padding: 32rpx 28rpx 28rpx;
  border-radius: var(--r-lg);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  overflow: hidden;
  transition: all 0.2s;
}

.car-card.active {
  background: linear-gradient(150deg, rgba(0, 212, 255, 0.1) 0%, var(--bg-card) 60%);
  border-color: rgba(0, 212, 255, 0.28);
}

.car-card:active {
  transform: scale(0.988);
}

/* 左侧颜色竖条 */
.cc-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 5rpx;
}

.cc-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.cc-title {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-wrap: wrap;
}

.cc-brand {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--t1);
  letter-spacing: -0.5rpx;
}

.cc-model {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t2);
}

.cc-year {
  font-size: 21rpx;
  color: var(--t4);
  font-family: "SF Mono", Consolas, monospace;
}

.active-badge {
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--cyan-soft);
  color: var(--cyan);
  font-weight: 600;
  flex-shrink: 0;
}

.cc-plate-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.cc-plate {
  font-size: 24rpx;
  color: var(--t3);
  font-family: "SF Mono", Consolas, monospace;
  letter-spacing: 1rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--line);
}

.cc-fuel {
  font-size: 21rpx;
  color: var(--t4);
}

.cc-stats {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
}

.ccs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ccs-val {
  font-family: "SF Mono", Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--t1);
  letter-spacing: -0.5rpx;
}

.ccs-label {
  font-size: 19rpx;
  color: var(--t4);
}

.ccs-div {
  width: 1rpx;
  height: 36rpx;
  background: var(--line);
}

.cc-edit {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  font-size: 21rpx;
  color: var(--cyan);
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  background: var(--cyan-soft);
}

.cc-edit:active {
  opacity: 0.7;
}

/* ============ 添加按钮 ============ */

.add-car-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 36rpx;
  border-radius: var(--r-md);
  border: 1rpx dashed var(--line-strong);
  background: rgba(255, 255, 255, 0.018);
}

.add-car-btn:active {
  background: rgba(0, 212, 255, 0.06);
  border-color: rgba(0, 212, 255, 0.3);
}

.acb-plus {
  font-size: 36rpx;
  color: var(--cyan);
  line-height: 1;
}

.acb-text {
  font-size: 27rpx;
  color: var(--t2);
  font-weight: 500;
}

/* ============ 说明 ============ */

.garage-note {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.022);
  border: 1rpx solid var(--line);
}

.gn-text {
  font-size: 21rpx;
  color: var(--t4);
  line-height: 1.72;
}

/* ============ 编辑弹层 ============ */

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.68);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  background: var(--bg-1);
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  animation: slideUp 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-handle {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.18);
  margin: 0 auto 24rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--t1);
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}

/* ============ 表单 ============ */

.form-group {
  margin-bottom: 24rpx;
}

.form-group.half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.fg-label {
  display: block;
  font-size: 22rpx;
  color: var(--t3);
  margin-bottom: 12rpx;
}

.fg-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-sm);
  background: var(--bg-2);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--t1);
  box-sizing: border-box;
}

.fg-placeholder {
  color: var(--t4);
  font-size: 26rpx;
}

.fg-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-sm);
  background: var(--bg-2);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--t1);
}

.fg-arrow {
  font-size: 32rpx;
  color: var(--t4);
}

/* ============ 颜色选择 ============ */

.color-row {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 0;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  transition: all 0.18s;
  position: relative;
}

.color-dot.selected {
  transform: scale(1.12);
}

.color-dot.selected::after {
  content: '';
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

/* ============ 底部按钮 ============ */

.sheet-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 24rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--line);
  flex-shrink: 0;
}

.small-btn {
  width: 180rpx;
}
