.records-page {
  padding: 0 32rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 汇总条 ============ */

.summary-bar {
  display: flex;
  align-items: center;
  padding: 32rpx 8rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  margin: 0 -32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  background: linear-gradient(180deg, rgba(0, 212, 255, 0.05), transparent);
}

.sb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.sb-val {
  color: var(--t1);
}

.sb-label {
  font-size: 20rpx;
  color: var(--t3);
}

.sb-sep {
  width: 1rpx;
  height: 40rpx;
  background: var(--line);
}

/* ============ 筛选 ============ */

.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.filter-chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--t3);
  background: var(--bg-2);
  border: 1rpx solid var(--line);
  transition: all 0.18s;
}

.filter-chip.active {
  background: var(--cyan-soft);
  color: var(--cyan);
  border-color: rgba(0, 212, 255, 0.34);
  font-weight: 600;
}

.filter-chip:active {
  transform: scale(0.94);
}

.filter-total {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.ft-label {
  font-size: 21rpx;
  color: var(--t4);
}

.ft-val {
  font-family: "SF Mono", Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--t2);
}

/* ============ 记录卡片 ============ */

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.record-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 26rpx;
  border-radius: var(--r-md);
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  position: relative;
  overflow: hidden;
}

.record-card:active {
  background: var(--bg-2);
}

/* 加满的记录左侧加一道青光条，方便快速扫读 */
.record-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 3rpx;
  background: var(--cyan);
  opacity: 0;
  border-radius: 2rpx;
}

/* ============ 日期块 ============ */

.rc-date-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 148rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.rc-date {
  font-family: "SF Mono", Consolas, monospace;
  font-size: 23rpx;
  color: var(--t2);
  letter-spacing: -0.3rpx;
}

.rc-weekday {
  font-size: 19rpx;
  color: var(--t4);
}

/* ============ 主信息 ============ */

.rc-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rc-row-1 {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.rc-mileage {
  font-family: "SF Mono", Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--t1);
  letter-spacing: -0.8rpx;
}

.rc-km {
  font-size: 20rpx;
  color: var(--t3);
  margin-right: 6rpx;
}

.tag-full {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 5rpx;
  background: var(--cyan-soft);
  color: var(--cyan);
  font-weight: 600;
  line-height: 1.5;
}

.tag-partial {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 5rpx;
  background: rgba(255, 255, 255, 0.06);
  color: var(--t3);
  font-weight: 500;
  line-height: 1.5;
}

.rc-row-2 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.rc-detail {
  font-size: 22rpx;
  color: var(--t3);
  font-family: "SF Mono", Consolas, monospace;
}

.rc-dot {
  font-size: 20rpx;
  color: var(--t4);
}

.rc-station {
  font-size: 21rpx;
  color: var(--t3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}

/* 油耗行 */
.rc-consumption {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(0, 212, 255, 0.07);
  align-self: flex-start;
}

.rcc-val {
  font-family: "SF Mono", Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--cyan);
}

.rcc-unit {
  font-size: 18rpx;
  color: var(--cyan);
  opacity: 0.75;
}

.rcc-sep {
  font-size: 18rpx;
  color: var(--t4);
  margin: 0 2rpx;
}

.rcc-cost {
  font-size: 19rpx;
  color: var(--t3);
  font-family: "SF Mono", Consolas, monospace;
}

.rc-no-consumption {
  align-self: flex-start;
}

.rnc-text {
  font-size: 20rpx;
  color: var(--t4);
  font-style: italic;
}

/* ============ 金额块 ============ */

.rc-amount-block {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.rc-amount {
  font-family: "SF Mono", Consolas, monospace;
  font-variant-numeric: tabular-nums;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--t1);
  letter-spacing: -0.5rpx;
}

.rc-arrow {
  font-size: 26rpx;
  color: var(--t4);
}

/* ============ 空态补充 ============ */

.empty-btn {
  margin-top: 12rpx;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  background: var(--cyan-soft);
  color: var(--cyan);
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid rgba(0, 212, 255, 0.3);
}

.empty-btn:active {
  opacity: 0.75;
}

.list-bottom-space {
  height: 200rpx;
}
